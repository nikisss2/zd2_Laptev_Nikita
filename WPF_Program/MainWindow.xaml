<Window x:Class="zd3_Laptev_Nikita.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт кабелей" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Добавление">
                <MenuItem Header="Добавить" Click="Add_Click"/>
            </MenuItem>
            <MenuItem Header="Удаление">
                <MenuItem Header="Удалить выбранный (по индексу)" Click="RemoveByIndex_Click"/>
                <MenuItem Header="Удалить по типу" Click="RemoveByType_Click"/>
            </MenuItem>
            <MenuItem Header="Операции">
                <MenuItem Header="Сортировать по качеству" Click="SortByQuality_Click"/>
                <MenuItem Header="Только экранированные" Click="OnlyShielded_Click"/>
                <MenuItem Header="Показать все" Click="ShowAll_Click"/>
                <MenuItem Header="Средняя цена" Click="AveragePrice_Click"/>
            </MenuItem>
        </Menu>

        <TextBlock DockPanel.Dock="Bottom" x:Name="txtStatus" Margin="10,4" FontWeight="Bold"/>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">

                <TextBlock Text="Тип кабеля" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                <RadioButton x:Name="rbBase" Content="Обычный" GroupName="CableType"
                             IsChecked="True" Checked="CableType_Changed" Margin="0,0,0,4"/>
                <RadioButton x:Name="rbShielded" Content="Экранированный" GroupName="CableType"
                             Checked="CableType_Changed" Margin="0,0,0,10"/>

                <TextBlock Text="Параметры кабеля" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                <TextBlock Text="Тип:"/>
                <TextBox x:Name="txtType" Margin="0,0,0,6"/>

                <TextBlock Text="Кол-во жил:"/>
                <TextBox x:Name="txtCores" Margin="0,0,0,6"/>

                <TextBlock Text="Диаметр:"/>
                <TextBox x:Name="txtDiameter" Margin="0,0,0,6"/>

                <TextBlock Text="Производитель:"/>
                <TextBox x:Name="txtManufacturer" Margin="0,0,0,6"/>

                <TextBlock Text="Цена:"/>
                <TextBox x:Name="txtPrice" Margin="0,0,0,10"/>

                <StackPanel x:Name="pnlShielded" Visibility="Collapsed">
                    <TextBlock Text="Параметры экранированного" FontWeight="Bold" Margin="0,0,0,6"/>

                    <CheckBox x:Name="chkShield" Content="Есть экран" Margin="0,0,0,6"/>

                    <TextBlock Text="Материал экрана:"/>
                    <TextBox x:Name="txtShieldMaterial" Margin="0,0,0,6"/>

                    <CheckBox x:Name="chkFlexible" Content="Гибкий" Margin="0,0,0,10"/>
                </StackPanel>

                <TextBlock Text="Тип для удаления:"/>
                <TextBox x:Name="txtRemoveType" Margin="0,0,0,6"/>
            </StackPanel>

            <ListBox Grid.Column="1" x:Name="lstCables"/>
        </Grid>
    </DockPanel>
</Window>