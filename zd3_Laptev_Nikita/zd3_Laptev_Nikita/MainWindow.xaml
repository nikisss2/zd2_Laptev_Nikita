<Window x:Class="zd3_Laptev_Nikita.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Плейлист" Height="520" Width="640">
    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Добавление">
                <MenuItem Header="Добавить (по полям)" Click="AddByFields_Click"/>
                <MenuItem Header="Добавить (Song)" Click="AddBySong_Click"/>
            </MenuItem>

            <MenuItem Header="Навигация">
                <MenuItem Header="В начало" Click="ToStart_Click"/>
                <MenuItem Header="Назад" Click="Previous_Click"/>
                <MenuItem Header="Текущая" Click="Current_Click"/>
                <MenuItem Header="Вперёд" Click="Next_Click"/>
                <Separator/>
                <MenuItem Header="Перейти по индексу" Click="JumpTo_Click"/>
            </MenuItem>

            <MenuItem Header="Удаление">
                <MenuItem Header="Удалить по индексу" Click="RemoveByIndex_Click"/>
                <MenuItem Header="Удалить выбранную (Song)" Click="RemoveBySong_Click"/>
                <Separator/>
                <MenuItem Header="Очистить плейлист" Click="ClearAll_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250px"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Автор:" Margin="0,0,0,2"/>
                <TextBox x:Name="txtAuthor" Margin="0,0,0,8"/>

                <TextBlock Text="Название:" Margin="0,0,0,2"/>
                <TextBox x:Name="txtTitle" Margin="0,0,0,8"/>

                <TextBlock Text="Файл:" Margin="0,0,0,2"/>
                <TextBox x:Name="txtFilename" Margin="0,0,0,8"/>

                <TextBlock Text="Индекс для перехода/удаления:" Margin="0,0,0,2"/>
                <TextBox x:Name="txtIndex" Margin="0,0,0,8"/>
            </StackPanel>
            

            <DockPanel Grid.Column="1">
                <TextBlock x:Name="lblCurrent" DockPanel.Dock="Top"
                           Text="Текущая: -" FontWeight="Bold" Margin="0,0,0,5"/>

                <ListBox x:Name="lstSongs" MouseDoubleClick="lstSongs_DoubleClick"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>